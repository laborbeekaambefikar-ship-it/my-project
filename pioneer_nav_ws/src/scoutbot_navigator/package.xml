<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>scoutbot_navigator</name>
  <version>0.1.0</version>
  <description>
    Pure-Python waypoint navigator. Implements a 6-state finite state machine
    (IDLE, ALIGN_HEADING, DRIVE, FINE_APPROACH, ALIGN_FINAL, REACHED, MISSION_DONE)
    with two PIDs (linear, angular). Subscribes to /scoutbot/odom, publishes
    /scoutbot/cmd_vel at 50 Hz and /scoutbot/nav_status at 2 Hz.
  </description>
  <maintainer email="dev@example.com">scoutbot maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf_transformations</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>scoutbot_interfaces</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
